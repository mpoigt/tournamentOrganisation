@model IEnumerable<TournamentApp.Models.Tournament>

@{
    ViewData["Title"] = "Турниры";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Турниры</h1>
    <div>
        <button type="button" class="btn btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#filterModal">
            <i class="bi bi-funnel"></i> Фильтр
            @if (Context.Request.Query.Count > 0)
            {
                <span class="badge bg-primary rounded-pill ms-1"> </span>
            }
        </button>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Создать турнир
        </a>
    </div>
</div>

@if (!Model.Any())
{
    bool hasActiveFilters = Context.Request.Query.Any(q => !string.IsNullOrWhiteSpace(q.Value));

    <div class="alert alert-info">
        <h4 class="alert-heading">Турниры не найдены</h4>
        @if (hasActiveFilters)
        {
            <p>По вашим параметрам фильтрации не найдено ни одного турнира. Попробуйте сбросить или изменить фильтры.</p>
        }
        else
        {
            <p>Пока не создано ни одного турнира. <a asp-action="Create" class="alert-link">Создайте первый турнир</a>.</p>
        }
    </div>
}
else
{
    <div class="row">
        @foreach (var tournament in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0 pe-2">@tournament.Name</h5>
                            <div class="text-end" style="min-width: 90px;">
                                <span class="badge bg-secondary w-100 mb-1">@tournament.Type?.Name</span>
                                <span class="badge bg-info text-dark w-100">@tournament.Gender?.Name</span>
                            </div>
                        </div>
                        
                        <p class="card-text text-muted mb-2">
                            <small>
                                <i class="bi bi-calendar"></i> @tournament.StartDate.ToString("dd.MM.yyyy")
                                @if (tournament.EndDate.HasValue)
                                {
                                    <span> - @tournament.EndDate.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </small>
                        </p>
                        
                        @if (!string.IsNullOrEmpty(tournament.Description))
                        {
                            <p class="card-text mb-3">@tournament.Description</p>
                        }

                        <div class="card bg-light border-0 mb-3 flex-grow-1">
                            <div class="card-body p-2" style="max-height: 120px; overflow-y: auto;">
                                <p class="mb-1 fw-bold" style="font-size: 0.85rem;">
                                    <i class="bi bi-people"></i> Участники (@tournament.TournamentParticipants.Count):
                                </p>
                                @if (tournament.TournamentParticipants != null && tournament.TournamentParticipants.Any())
                                {
                                    <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
                                        @foreach (var tp in tournament.TournamentParticipants)
                                        {
                                            <li class="mb-1">
                                                <i class="bi bi-person text-secondary"></i> @tp.Participant?.Name
                                                @if (!string.IsNullOrWhiteSpace(tp.TeamName))
                                                {
                                                    <span class="text-muted fst-italic"> — @tp.TeamName</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.85rem;">Нет участников</span>
                                }
                            </div>
                        </div>
                        
                        @if (tournament.IsCompleted)
                        {
                            <div class="alert alert-success py-2 mb-3">
                                <i class="bi bi-check-circle"></i> <strong>Турнир завершен</strong>
                                @if (tournament.Winner != null)
                                {
                                    <br>
                                    <i class="bi bi-trophy text-warning mt-1"></i> <strong>Победитель:</strong> 
                                    @tournament.Winner.Name
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 mb-3">
                                <i class="bi bi-clock"></i> <strong>Турнир в процессе</strong>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <div class="btn-group" role="group">
                                <a asp-action="Matches" asp-route-id="@tournament.Id" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-list-check"></i> Матчи
                                </a>
                                <a asp-action="Standings" asp-route-id="@tournament.Id" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-trophy"></i> Таблица
                                </a>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@tournament.Id">
                                            <i class="bi bi-pencil"></i> Редактировать
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@tournament.Id">
                                            <i class="bi bi-trash"></i> Удалить
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="get" asp-action="Index">
                <div class="modal-header">
                    <h5 class="modal-title" id="filterModalLabel"><i class="bi bi-funnel"></i> Фильтр турниров</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Дата начала (с)</label>
                            <input type="date" name="DateFrom" class="form-control" value="@Context.Request.Query["DateFrom"]" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Дата конца (по)</label>
                            <input type="date" name="DateTo" class="form-control" value="@Context.Request.Query["DateTo"]" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Статус турнира</label>
                        <select name="IsCompleted" class="form-select">
                            <option value="">Все</option>
                            <option value="false" selected="@(Context.Request.Query["IsCompleted"] == "false" ? "selected" : null)">В процессе</option>
                            <option value="true" selected="@(Context.Request.Query["IsCompleted"] == "true" ? "selected" : null)">Завершен</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Тип турнира</label>
                        <select name="TournamentType" class="form-select">
                            <option value="">Все типы</option>
                            <option value="5 на 5" selected="@(Context.Request.Query["TournamentType"] == "5 на 5" ? "selected" : null)">5 на 5</option>
                            <option value="5 на 5 с большими" selected="@(Context.Request.Query["TournamentType"] == "5 на 5 с большими" ? "selected" : null)">5 на 5 с большими</option>
                            <option value="11 на 11" selected="@(Context.Request.Query["TournamentType"] == "11 на 11" ? "selected" : null)">11 на 11</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Тип команд (Пол)</label>
                        <select name="TeamGender" class="form-select">
                            <option value="">Любой</option>
                            <option value="Мужчины" selected="@(Context.Request.Query["TeamGender"] == "Мужчины" ? "selected" : null)">Мужчины</option>
                            <option value="Женщины" selected="@(Context.Request.Query["TeamGender"] == "Женщины" ? "selected" : null)">Женщины</option>
                        </select>
                    </div>
                    
                </div>
                
                <div class="modal-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Очистить</a>
                    <button type="submit" class="btn btn-primary">Применить</button>
                </div>
            </form>
        </div>
    </div>
</div>