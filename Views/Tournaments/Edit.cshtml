@model TournamentApp.DTOs.EditTournamentDTO

@{
    ViewData["Title"] = "Редактировать турнир";
}

<link rel="stylesheet" href="~/css/tournament-create.css" />

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h2>Редактировать турнир</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название турнира *</label>
                        <input asp-for="Name" class="form-control" placeholder="Введите название турнира" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StartDate" class="form-label">Дата начала *</label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Тип турнира</label>
                                <input class="form-control" value="@Model.TypeDisplay" disabled />
                                <div class="form-text text-muted">Тип турнира изменить нельзя</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Категория (Пол)</label>
                                <input class="form-control" value="@Model.GenderDisplay" disabled />
                                <div class="form-text text-muted">Категорию изменить нельзя</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Описание турнира (необязательно)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Участники и их команды</label>
                        <ul class="list-group">
                            @if (Model.Participants != null && Model.Participants.Any())
                            {
                                foreach (var p in Model.Participants)
                                {
                                    <li class="list-group-item d-flex align-items-center edit-participant-item">
                                        <div class="edit-participant-name">
                                            <i class="bi bi-person-fill text-secondary me-2"></i>
                                            @p.Key
                                        </div>
                
                                        <div class="edit-participant-team-container">
                                            <span class="badge bg-primary rounded-pill edit-participant-badge" title="@p.Value">
                                                @p.Value
                                            </span>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item text-muted">Участники не найдены</li>
                            }
                        </ul>
                        
                        <div class="form-text text-muted mt-2">
                            <i class="bi bi-info-circle"></i>
                            Участников турнира нельзя изменить после создания. Для изменения состава создайте новый турнир.
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Назад к списку
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}