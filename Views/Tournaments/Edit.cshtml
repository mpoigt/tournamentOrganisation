@model TournamentApp.Models.Tournament

@{
    ViewData["Title"] = "Редактировать турнир";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h2>Редактировать турнир</h2>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Название турнира *</label>
                        <input asp-for="Name" class="form-control" placeholder="Введите название турнира" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StartDate" class="form-label">Дата начала *</label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Тип турнира</label>
                                <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<TournamentApp.Models.Tournament.TournamentType>()" disabled></select>
                                <div class="form-text text-muted">Тип турнира изменить нельзя</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Категория (Пол)</label>
                                <select class="form-select" asp-for="Gender" asp-items="Html.GetEnumSelectList<TournamentApp.Models.Tournament.TeamGender>()" disabled></select>
                                <div class="form-text text-muted">Категорию изменить нельзя</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Описание турнира (необязательно)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Участники и их команды</label>
                        <ul class="list-group">
                        @if (Model.TournamentParticipants != null && Model.TournamentParticipants.Any())
                        {
                            foreach (var tp in Model.TournamentParticipants)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-fill text-secondary me-2"></i>
                                            @tp.Participant?.Name
                                    </div>
                                    <span class="badge bg-primary rounded-pill" style="font-size: 0.9rem;">
                                        @tp.TeamName
                                    </span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">Участники не найдены</li>
                        }
                        </ul>
                        
                        <div class="form-text text-muted mt-2">
                            <i class="bi bi-info-circle"></i> 
                            Участников турнира нельзя изменить после создания. Для изменения состава создайте новый турнир.
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Назад к списку
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}