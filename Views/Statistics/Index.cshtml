@model TournamentApp.ViewModels.StatisticsIndexViewModel
@{
    ViewData["Title"] = "Статистика";
}

<div class="text-center mb-4">
    <h1><i class="bi bi-graph-up"></i> Статистика</h1>
    <p class="text-muted">Общая статистика по участникам и встречам</p>
</div>


<ul class="nav nav-tabs nav-justified mb-4" id="statsTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="participants-tab" data-bs-toggle="tab" data-bs-target="#participants"
                type="button" role="tab" aria-controls="participants" aria-selected="true">
            <i class="bi bi-people"></i> Участники
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="headtohead-tab" data-bs-toggle="tab" data-bs-target="#headtohead"
                type="button" role="tab" aria-controls="headtohead" aria-selected="false">
            <i class="bi bi-arrows-collapse"></i> Личные встречи
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="topscored-tab" data-bs-toggle="tab" data-bs-target="#topscored"
                type="button" role="tab" aria-controls="topscored" aria-selected="false">
            <i class="bi bi-sort-up text-success"></i> Забитые
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="topconceded-tab" data-bs-toggle="tab" data-bs-target="#topconceded"
                type="button" role="tab" aria-controls="topconceded" aria-selected="false">
            <i class="bi bi-sort-down text-danger"></i> Пропущенные
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bestmatches-tab" data-bs-toggle="tab" data-bs-target="#bestmatches"
                type="button" role="tab" aria-controls="bestmatches" aria-selected="false">
            <i class="bi bi-fire text-warning"></i> Топ матчей
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="besthomematches-tab" data-bs-toggle="tab" data-bs-target="#besthomematches"
                type="button" role="tab" aria-controls="besthomematches" aria-selected="false">
            <i class="bi bi-house-door text-primary"></i> Топ хозяев
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bestawaymatches-tab" data-bs-toggle="tab" data-bs-target="#bestawaymatches"
                type="button" role="tab" aria-controls="bestawaymatches" aria-selected="false">
            <i class="bi bi-airplane text-info"></i> Топ гостей
        </button>
    </li>
</ul>


<div class="tab-content" id="statsTabContent">

    <div class="tab-pane fade show active" id="participants" role="tabpanel" aria-labelledby="participants-tab">
        @if (Model.ParticipantStats == null || !Model.ParticipantStats.Any())
        {
            <div class="alert alert-info text-center">
                <h4 class="alert-heading">Статистика не найдена</h4>
                <p>Пока нет данных для отображения статистики участников.</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var stats in Model.ParticipantStats.OrderByDescending(s => s.WinPercentage))
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header bg-primary text-white text-center">
                                <h5 class="mb-0"><i class="bi bi-person-circle"></i> @stats.ParticipantName</h5>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <h4 class="text-info">@stats.TotalTournaments</h4>
                                        <small class="text-muted">Турниров</small>
                                    </div>
                                    <div class="col-6">
                                        <h4 class="text-info">@stats.TotalMatches</h4>
                                        <small class="text-muted">Матчей</small>
                                    </div>
                                </div>
                                <hr>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <h5 class="text-success">@stats.TotalWins</h5>
                                        <small class="text-muted">Побед</small>
                                    </div>
                                    <div class="col-4">
                                        <h5 class="text-warning">@stats.TotalDraws</h5>
                                        <small class="text-muted">Ничьи</small>
                                    </div>
                                    <div class="col-4">
                                        <h5 class="text-danger">@stats.TotalLosses</h5>
                                        <small class="text-muted">Поражений</small>
                                    </div>
                                </div>
                                <hr>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <h6 class="text-primary">@stats.TotalGoalsScored</h6>
                                        <small class="text-muted">Голов</small>
                                    </div>
                                    <div class="col-4">
                                        <h6 class="text-secondary">@stats.TotalGoalsConceded</h6>
                                        <small class="text-muted">Пропущено</small>
                                    </div>
                                    <div class="col-4">
                                        <h6 class="@(stats.GoalDifference >= 0 ? "text-success" : "text-danger")">
                                            @(stats.GoalDifference >= 0 ? "+" : "")@stats.GoalDifference
                                        </h6>
                                        <small class="text-muted">Разность</small>
                                    </div>
                                </div>
                                <div class="mt-3 text-center">
                                    <div class="progress mb-2">
                                        <div class="progress-bar bg-success" role="progressbar"
                                             style="width: @(stats.WinPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                                             aria-valuenow="@(stats.WinPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                             aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <small class="text-muted">Процент побед: <strong>@stats.WinPercentage.ToString("F1")%</strong></small>
                                </div>
                            </div>
                            <div class="card-footer text-center">
                                <a asp-action="Participant" asp-route-id="@stats.ParticipantId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>


    <div class="tab-pane fade" id="headtohead" role="tabpanel" aria-labelledby="headtohead-tab">
        @if (Model.HeadToHeadStats == null || !Model.HeadToHeadStats.Any())
        {
            <div class="alert alert-info text-center">
                <h4 class="alert-heading">Данные не найдены</h4>
                <p>Пока нет данных о личных встречах между участниками.</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var stats in Model.HeadToHeadStats.OrderByDescending(s => s.TotalMatches))
                {
                    double p1WinPercentage = stats.TotalMatches > 0 ? ((double)stats.Participant1Wins / stats.TotalMatches) * 100 : 0;
                    double drawPercentage = stats.TotalMatches > 0 ? ((double)stats.Draws / stats.TotalMatches) * 100 : 0;
                    double p2WinPercentage = stats.TotalMatches > 0 ? ((double)stats.Participant2Wins / stats.TotalMatches) * 100 : 0;
                    var invCulture = System.Globalization.CultureInfo.InvariantCulture;

                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 d-flex flex-column">
                            <div class="card-header bg-info text-white text-center">
                                <h6 class="mb-0">
                                    <i class="bi bi-arrows-collapse"></i>
                                    @stats.Participant1Name vs @stats.Participant2Name
                                </h6>
                            </div>
                            <div class="card-body text-center d-flex flex-column justify-content-between">
                
                                <div>
                                    <div class="row align-items-center mb-3">
                                        <div class="col-5">
                                            <h6 class="fw-bold mb-1">@stats.Participant1Name</h6>
                                            <small class="text-success fw-bold">@p1WinPercentage.ToString("F1")%</small>
                                        </div>
                                        <div class="col-2">
                                            <h4 class="text-primary mb-0">@stats.TotalMatches</h4>
                                            <small class="text-muted" style="font-size: 0.75rem;">матчей</small>
                                        </div>
                                        <div class="col-5">
                                            <h6 class="fw-bold mb-1">@stats.Participant2Name</h6>
                                            <small class="text-primary fw-bold">@p2WinPercentage.ToString("F1")%</small>
                                        </div>
                                    </div>
                                
                                    <div class="row text-center mb-3">
                                        <div class="col-4">
                                            <h5 class="text-success mb-0">@stats.Participant1Wins</h5>
                                            <small class="text-muted">Побед</small>
                                        </div>
                                        <div class="col-4">
                                            <h5 class="text-warning mb-0">@stats.Draws</h5>
                                            <small class="text-muted">Ничьи</small>
                                        </div>
                                        <div class="col-4">
                                            <h5 class="text-success mb-0">@stats.Participant2Wins</h5>
                                            <small class="text-muted">Побед</small>
                                        </div>
                                    </div>
                                
                                    <div class="row text-center mb-2">
                                        <div class="col-5">
                                            <h6 class="text-primary mb-0">@stats.Participant1Goals</h6>
                                            <small class="text-muted">голов</small>
                                        </div>
                                        <div class="col-2">
                                            <h6 class="text-muted">:</h6>
                                        </div>
                                        <div class="col-5">
                                            <h6 class="text-primary mb-0">@stats.Participant2Goals</h6>
                                            <small class="text-muted">голов</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-auto pt-3">
                                    <div class="progress" style="height: 12px; border-radius: 6px;">
                                        @if (stats.TotalMatches > 0)
                                        {
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @(p1WinPercentage.ToString(invCulture))%"
                                                 aria-valuenow="@(p1WinPercentage.ToString(invCulture))" aria-valuemin="0" aria-valuemax="100"
                                                 data-bs-toggle="tooltip" title="Победы @stats.Participant1Name"></div>
                            
                                            <div class="progress-bar bg-secondary" role="progressbar"
                                                 style="width: @(drawPercentage.ToString(invCulture))%"
                                                 aria-valuenow="@(drawPercentage.ToString(invCulture))" aria-valuemin="0" aria-valuemax="100"
                                                 data-bs-toggle="tooltip" title="Ничьи"></div>
                            
                                            <div class="progress-bar bg-primary" role="progressbar"
                                                 style="width: @(p2WinPercentage.ToString(invCulture))%"
                                                 aria-valuenow="@(p2WinPercentage.ToString(invCulture))" aria-valuemin="0" aria-valuemax="100"
                                                 data-bs-toggle="tooltip" title="Победы @stats.Participant2Name"></div>
                                        }
                                        else
                                        {
                                            <div class="progress-bar bg-light text-muted w-100" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                                                <small>Нет сыгранных матчей</small>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="tab-pane fade" id="topscored" role="tabpanel" aria-labelledby="topscored-tab">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-trophy"></i> Лучшие бомбардиры (Топ-10)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="top-rank-col">#</th>
                                <th>Участник</th>
                                <th class="text-center">Матчей</th>
                                <th class="text-center text-success">Забито голов</th>
                                <th class="text-center">Голов за матч</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rankScored = 1;
                            }
                            @if (Model.Top10Scored != null && Model.Top10Scored.Any())
                            {
                                foreach (var stats in Model.Top10Scored)
                                {
                                    var goalsPerMatch = stats.TotalMatches > 0 ? (double)stats.TotalGoalsScored / stats.TotalMatches : 0;
                                    <tr>
                                        <td class="top-rank-col fw-bold">@rankScored</td>
                                        <td>
                                            <a asp-action="Participant" asp-route-id="@stats.ParticipantId" class="text-decoration-none fw-bold text-dark">
                                                @stats.ParticipantName
                                            </a>
                                        </td>
                                        <td class="text-center">@stats.TotalMatches</td>
                                        <td class="text-center fw-bold text-success fs-5">@stats.TotalGoalsScored</td>
                                        <td class="text-center text-muted">@goalsPerMatch.ToString("F1")</td>
                                    </tr>
                                    rankScored++;
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center py-3">Нет данных</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="topconceded" role="tabpanel" aria-labelledby="topconceded-tab">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-shield-x"></i> Топ-10 по пропущенным голам</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="top-rank-col">#</th>
                                <th>Участник</th>
                                <th class="text-center">Матчей</th>
                                <th class="text-center text-danger">Пропущено голов</th>
                                <th class="text-center">Пропущено за матч</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rankConceded = 1;
                            }
                            @if (Model.Top10Conceded != null && Model.Top10Conceded.Any())
                            {
                                foreach (var stats in Model.Top10Conceded)
                                {
                                    var concededPerMatch = stats.TotalMatches > 0 ? (double)stats.TotalGoalsConceded / stats.TotalMatches : 0;
                                    <tr>
                                        <td class="top-rank-col fw-bold">@rankConceded</td>
                                        <td>
                                            <a asp-action="Participant" asp-route-id="@stats.ParticipantId" class="text-decoration-none fw-bold text-dark">
                                                @stats.ParticipantName
                                            </a>
                                        </td>
                                        <td class="text-center">@stats.TotalMatches</td>
                                        <td class="text-center fw-bold text-danger fs-5">@stats.TotalGoalsConceded</td>
                                        <td class="text-center text-muted">@concededPerMatch.ToString("F1")</td>
                                    </tr>
                                    rankConceded++;
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center py-3">Нет данных</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="bestmatches" role="tabpanel" aria-labelledby="bestmatches-tab">
        <div class="card">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-fire"></i> Самые результативные матчи (Всего голов)</h5>
            
                <select id="tournamentTypeFilter" class="form-select form-select-sm w-auto fw-bold" onchange="filterMatches(this.value, 'best-matches-container', 'matches-container')">
                    @foreach (var type in TournamentApp.Enums.TournamentType.All)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </div>
        
            <div class="card-body p-0">
                @foreach (var tType in TournamentApp.Enums.TournamentType.All)
                {
                    var matchesForType = Model.MostProductiveMatches
                        .Where(m => m.Tournament?.Type?.Code == tType.Code)
                        .OrderByDescending(m => (m.HomeScore ?? 0) + (m.AwayScore ?? 0))
                        .Take(10)
                        .ToList();

                    <div class="table-responsive best-matches-container" id="matches-container-@tType.Code" style="display: none;">
                        <table class="table table-hover table-striped mb-0 text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата</th>
                                    <th>Турнир</th>
                                    <th class="text-end">Участник 1</th>
                                    <th class="text-center">Счет</th>
                                    <th class="text-start">Участник 2</th>
                                    <th class="text-center">Всего голов</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (matchesForType.Any())
                                {
                                    foreach (var match in matchesForType)
                                    {
                                        <tr>
                                            <td class="text-muted">@match.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td class="fw-bold text-primary">@match.Tournament?.Name</td>
                                            <td class="text-end fw-bold">@match.HomeParticipant?.Name</td>
                                            <td class="text-center fs-5 bg-light fw-bold px-3">
                                                @match.HomeScore : @match.AwayScore
                                            </td>
                                            <td class="text-start fw-bold">@match.AwayParticipant?.Name</td>
                                            <td class="text-center text-danger fw-bold fs-5">
                                                @(match.HomeScore + match.AwayScore)
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">Нет сыгранных матчей для данного типа турнира.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="besthomematches" role="tabpanel" aria-labelledby="besthomematches-tab">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-house-door"></i> Топ-10: Забили хозяева</h5>
            
                <select id="homeTournamentTypeFilter" class="form-select form-select-sm w-auto fw-bold" onchange="filterMatches(this.value, 'home-matches-container', 'home-matches-container')">
                    @foreach (var type in TournamentApp.Enums.TournamentType.All)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </div>
        
            <div class="card-body p-0">
                @foreach (var tType in TournamentApp.Enums.TournamentType.All)
                {
                    var homeMatchesForType = Model.MostProductiveMatches
                        .Where(m => m.Tournament?.Type?.Code == tType.Code)
                        .OrderByDescending(m => m.HomeScore ?? 0)
                        .Take(10)
                        .ToList();

                    <div class="table-responsive home-matches-container" id="home-matches-container-@tType.Code" style="display: none;">
                        <table class="table table-hover table-striped mb-0 text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата</th>
                                    <th>Турнир</th>
                                    <th class="text-end">Хозяева</th>
                                    <th class="text-center">Счет</th>
                                    <th class="text-start">Гости</th>
                                    <th class="text-center text-primary">Голы хозяев</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (homeMatchesForType.Any())
                                {
                                    foreach (var match in homeMatchesForType)
                                    {
                                        <tr>
                                            <td class="text-muted">@match.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td class="fw-bold text-primary">@match.Tournament?.Name</td>
                                            <td class="text-end fw-bold">@match.HomeParticipant?.Name</td>
                                            <td class="text-center fs-5 bg-light fw-bold px-3">
                                                @match.HomeScore : @match.AwayScore
                                            </td>
                                            <td class="text-start text-muted">@match.AwayParticipant?.Name</td>
                                            <td class="text-center text-primary fw-bold fs-5">
                                                @match.HomeScore
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">Нет сыгранных матчей для данного типа турнира.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="bestawaymatches" role="tabpanel" aria-labelledby="bestawaymatches-tab">
        <div class="card">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-airplane"></i> Топ-10: Забили гости</h5>
            
                <select id="awayTournamentTypeFilter" class="form-select form-select-sm w-auto fw-bold" onchange="filterMatches(this.value, 'away-matches-container', 'away-matches-container')">
                    @foreach (var type in TournamentApp.Enums.TournamentType.All)
                    {
                        <option value="@type.Code">@type.Name</option>
                    }
                </select>
            </div>
        
            <div class="card-body p-0">
                @foreach (var tType in TournamentApp.Enums.TournamentType.All)
                {
                    var awayMatchesForType = Model.MostProductiveMatches
                        .Where(m => m.Tournament?.Type?.Code == tType.Code)
                        .OrderByDescending(m => m.AwayScore ?? 0)
                        .Take(10)
                        .ToList();

                    <div class="table-responsive away-matches-container" id="away-matches-container-@tType.Code" style="display: none;">
                        <table class="table table-hover table-striped mb-0 text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Дата</th>
                                    <th>Турнир</th>
                                    <th class="text-end">Хозяева</th>
                                    <th class="text-center">Счет</th>
                                    <th class="text-start">Гости</th>
                                    <th class="text-center text-info">Голы гостей</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (awayMatchesForType.Any())
                                {
                                    foreach (var match in awayMatchesForType)
                                    {
                                        <tr>
                                            <td class="text-muted">@match.CreatedAt.ToString("dd.MM.yyyy")</td>
                                            <td class="fw-bold text-primary">@match.Tournament?.Name</td>
                                            <td class="text-end text-muted">@match.HomeParticipant?.Name</td>
                                            <td class="text-center fs-5 bg-light fw-bold px-3">
                                                @match.HomeScore : @match.AwayScore
                                            </td>
                                            <td class="text-start fw-bold">@match.AwayParticipant?.Name</td>
                                            <td class="text-center text-info fw-bold fs-5">
                                                @match.AwayScore
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">Нет сыгранных матчей для данного типа турнира.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterMatches(typeCode, containerClass, prefix) {
            document.querySelectorAll('.' + containerClass).forEach(function(el) {
                el.style.display = 'none';
            });
            
            var selectedContainer = document.getElementById(prefix + '-' + typeCode);
            if (selectedContainer) {
                selectedContainer.style.display = 'block';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            var bestMatchesFilter = document.getElementById('tournamentTypeFilter');
            if (bestMatchesFilter) {
                filterMatches(bestMatchesFilter.value, 'best-matches-container', 'matches-container');
            }

            var homeMatchesFilter = document.getElementById('homeTournamentTypeFilter');
            if (homeMatchesFilter) {
                filterMatches(homeMatchesFilter.value, 'home-matches-container', 'home-matches-container');
            }

            var awayMatchesFilter = document.getElementById('awayTournamentTypeFilter');
            if (awayMatchesFilter) {
                filterMatches(awayMatchesFilter.value, 'away-matches-container', 'away-matches-container');
            }
        });
    </script>
}